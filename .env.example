# MediaShield Environment Configuration

# Database (Default: SQLite for zero-friction local setup, PostgreSQL supported)
DATABASE_URL="file:./dev.db"

# Cloudinary Configuration
# Sign up at https://cloudinary.com to obtain credentials
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# Demo Mode
# Set to 'true' to allow simulation/fallback when credentials or paid add-ons are unavailable.
# Set to 'false' to require strict live Cloudinary calls.
DEMO_MODE="true"

# Next.js App URL (Optional, for absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
